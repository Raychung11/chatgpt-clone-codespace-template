Options -Indexes

RewriteEngine On
RewriteBase /

# -------------------------------------------------------
# Block direct access to sensitive directories
# -------------------------------------------------------
RewriteRule ^config/ - [F,L]
RewriteRule ^inc/ - [F,L]
RewriteRule ^modules/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^\.env - [F,L]

# -------------------------------------------------------
# API: /api/* → api/index.php
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# -------------------------------------------------------
# Admin panel: /admin/* → admin/index.php
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.+)$ admin/index.php [QSA,L]

RewriteRule ^admin/?$ admin/index.php [QSA,L]

# -------------------------------------------------------
# Customer PWA: /app/* → public/index.php
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^app/(.+)$ public/index.php [QSA,L]

RewriteRule ^app/?$ public/index.php [QSA,L]

# -------------------------------------------------------
# Root → /app/
# -------------------------------------------------------
RewriteRule ^$ /app/ [R=302,L]

# -------------------------------------------------------
# Force HTTPS – uncomment ONLY after SSL is active
# -------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
