# Root .htaccess — route root requests to the public landing page

Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Redirect domain root → /public/index.php (landing page)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # motions.my or motions.my/ → /public/index.php
    RewriteRule ^$ /public/index.php [L,R=301]

    # Block direct browser access to server-side directories
    RewriteRule ^(config|inc|cron|logs|sql)(/|$) - [F,L]
</IfModule>
