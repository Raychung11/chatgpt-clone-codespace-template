# =====================================================
# F&B Loyalty Platform – Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.
# =====================================================

# Application
APP_NAME="F&B Loyalty Platform"
APP_URL=https://steelblue-seahorse-403796.hostingersite.com
APP_ENV=production
# Set to true during initial setup/testing to enable debug OTP (123456)
# Change back to false in production!
APP_DEBUG=true

# Database (get these from Hostinger hPanel → Databases → MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# WhatsApp / AiServe (optional – leave blank to use debug OTP only)
WHATSAPP_API_URL=https://api.aiservemsg.com/v1
WHATSAPP_API_KEY=your_aiServe_api_key
WHATSAPP_SENDER=60xxxxxxxxx

# Payment (optional)
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx

# Google Maps (optional)
GOOGLE_MAPS_KEY=your_google_maps_api_key
