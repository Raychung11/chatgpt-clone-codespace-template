Options -Indexes
Options -MultiViews

# ── App Environment Variables ─────────────────────────────────────────────────
# APP_URL: no trailing slash, no /plotgold — root .htaccess handles the mapping
SetEnv APP_URL https://plotgold.com
SetEnv APP_ENV production

RewriteEngine On

# Force HTTPS (handled by root .htaccess, kept here as fallback)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block access to sensitive directories
RewriteRule ^(config|inc|sql|logs|uploads/documents)/ - [F,L]

# Block dot files
RewriteRule (^\.|/\.) - [F,L]

# SEO-friendly park pages
RewriteRule ^parks/([a-z0-9\-]+)/?$ parks/detail.php?slug=$1 [L,QSA]

# SEO-friendly city pages
RewriteRule ^city/([a-z0-9\-]+)/?$ city/index.php?slug=$1 [L,QSA]

# SEO-friendly listing pages
RewriteRule ^listing/([a-z0-9\-]+)/?$ listing_detail.php?slug=$1 [L,QSA]

# Canonical URL rewrites
RewriteRule ^sell-my-burial-plot/?$ sell_plot.php [L]
RewriteRule ^compare-burial-plots/?$ buyer/compare.php [L]
RewriteRule ^funeral-planner/?$ diy_funeral_planner.php [L]
RewriteRule ^columbarium-niches/?$ browse_listings.php?type=columbarium [L]
RewriteRule ^urgent-funeral-help/?$ request_quote.php?mode=urgent [L]

# Security headers (Apache mod_headers)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Deny PHP execution in uploads
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Deny from all
    </If>
</FilesMatch>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
