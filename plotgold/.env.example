# PlotGold Malaysia — Environment Configuration
# Copy this file to .env and set values (never commit .env to git)

APP_ENV=production
APP_URL=https://yourdomain.com/plotgold
APP_DEBUG=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plotgold
DB_USER=plotgold_user
DB_PASS=your_secure_password_here

# WhatsApp
WHATSAPP_NUMBER=601112345678

# Email (optional SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here
