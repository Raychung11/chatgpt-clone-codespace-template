# BytePlus Clone Avatar — credentials and endpoint configuration
# Copy this file to config/.env and fill in your values.

# ── BytePlus CV API (required) ─────────────────────────────────────────────
ACCESS_KEY_ID=your_access_key_id_here
SECRET_ACCESS_KEY=your_secret_access_key_here
API_BASE_URL=https://cv.byteplusapi.com
SERVICE=cv
REGION=ap-singapore-1

# ── BytePlus TOS (required only when passing local file paths) ─────────────
# If you always pass public http(s) URLs, leave these blank.
# TOS_ACCESS_KEY_ID and TOS_SECRET_ACCESS_KEY default to the CV keys above
# when left blank (works if the same IAM grants TOS access).
TOS_BUCKET=your-tos-bucket-name
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
TOS_REGION=ap-southeast-1
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_URL_EXPIRY_SECONDS=43200

# ── Optional ───────────────────────────────────────────────────────────────
# BytePlus-provided test avatar resource_id (free-trial accounts only).
# Used by examples/workflow_example.py --use-test-avatar
TEST_AVATAR_RESOURCE_ID=250623-zhibo-linyunzhi
