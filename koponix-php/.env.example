# ============================================================
#  KOPONIX — Environment Variables
#  ─────────────────────────────────────────────────────────
#  HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked with  ← FILL IN
#   3. NEVER commit .env to git — it is already in .gitignore
#
#  WHERE TO FIND THESE VALUES (Hostinger):
#   • DB_*      → hPanel › Databases › MySQL Databases
#   • SITE_URL  → hPanel › Domains › your primary domain
#   • API key   → https://console.anthropic.com › API Keys
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Hostinger format: u<accountid>_<name>
DB_HOST=localhost
DB_NAME=u123456789_koponix          # ← FILL IN
DB_USER=u123456789_koponix          # ← FILL IN
DB_PASS=YourStrongDatabasePassword  # ← FILL IN

# ── Anthropic Claude API ──────────────────────────────────────
# https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # ← FILL IN

# ── Site ─────────────────────────────────────────────────────
# No trailing slash. Use https:// once SSL is active on Hostinger.
SITE_URL=https://yourdomain.com    # ← FILL IN
SITE_EMAIL=noreply@yourdomain.com  # ← FILL IN

# ── Email Notifications ───────────────────────────────────────
# 1 = send email on listing approved/rejected, new message, referral bonus
# 0 = disable (use 0 if PHP mail() is not configured)
NOTIFY_EMAIL=1

# ── Koperasi Identity ─────────────────────────────────────────
KOPERASI_NAME=Koperasi Kakitangan Bank Rakyat
KOPERASI_ABBREV=KKBR
KOPERASI_TAGLINE=Bersatu, Berusaha, Berjaya
KOPERASI_EMAIL=info@kkbr.com.my   # ← FILL IN
KOPERASI_PHONE=+603-XXXX-XXXX     # ← FILL IN
KOPERASI_ADDRESS=Wisma Bank Rakyat, Kuala Lumpur
KOPERASI_SKM_NO=SKM-XXXX-XXXX     # ← FILL IN

# ── Social Media (optional — leave blank to hide footer links) ─
KOPERASI_FB=
KOPERASI_IG=

# ── Member ID Prefix ─────────────────────────────────────────
# All member IDs must start with this. Change only before first launch.
MEMBER_ID_PREFIX=KKBR-
