# ============================================================
#  KOPONIX – Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git or share it publicly.
# ============================================================

# Database (from Hostinger cPanel → MySQL Databases)
DB_HOST=localhost
DB_NAME=u123456789_koponix
DB_USER=u123456789_admin
DB_PASS=your_strong_db_password

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Site URL (no trailing slash)
SITE_URL=https://yourdomain.com

# Email address used as the FROM address for notifications
SITE_EMAIL=noreply@yourdomain.com

# Set to '1' to enable email notifications, '0' to disable
NOTIFY_EMAIL=1

# Koperasi details
KOPERASI_NAME=Koperasi Kakitangan Bank Rakyat
KOPERASI_ABBREV=KKBR
KOPERASI_TAGLINE=Bersatu, Berusaha, Berjaya
KOPERASI_EMAIL=info@kkbr.com.my
KOPERASI_PHONE=+603-XXXX-XXXX
KOPERASI_ADDRESS=Wisma Bank Rakyat, Kuala Lumpur
KOPERASI_SKM_NO=SKM-XXXX-XXXX
KOPERASI_FB=
KOPERASI_IG=
MEMBER_ID_PREFIX=KKBR-
